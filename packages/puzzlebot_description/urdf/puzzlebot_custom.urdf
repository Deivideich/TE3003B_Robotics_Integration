<?xml version="1.0"?>
<robot name="simple_robot"
    xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Base Footprint (Body) -->
    <link name="base_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.0 0.0 0.0"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.0 0.0 0.0"/>
            </geometry>
        </collision>
    </link>

    <link name="base_footprint">
        <visual>
            <origin xyz="0.052 0.0 0.10" rpy="1.57 0.0 3.1416"/>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_puzzlebot_jetson_lidar_base.stl" scale="1.0 1.0 1.0"/>
            </geometry>
            <material name="gray">
                <color rgba="0.6 0.6 0.6 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0.052 0.0 0.10" rpy="1.57 0.0 0.0"/>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_puzzlebot_jetson_lidar_base.stl" scale="1.0 1.0 1.0"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.052 0.0 0.10" rpy="1.57 0.0 0.0"/>
            <mass value="10.5"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
    </link>

    <link name="wheel_r_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="3.14 1.57 0"/>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="3.14 1.57 0"/>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>0.0</mu>
                        <mu2>0.0</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="3.14 1.57 0"/>
            <mass value="0.3"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <link name="wheel_l_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 1.57 0"/>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0 1.57 0"/>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>0.0</mu>
                        <mu2>0.0</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0 1.57 0"/>
            <mass value="0.3"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>
    <link name="caster_link">
        <visual>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_caster_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_caster_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>0.0</mu>
                        <mu2>0.0</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
        <inertial>
            <mass value="3.5"/>
            <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
        </inertial>
    </link>


    <link name="laser_frame"/>

    <!-- <link name="laser_frame"/> -->
    <joint name="base_link_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>
    
    <joint name="wheel_l_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_l_link"/>
        <origin xyz="0.052 0.095 -0.0025" rpy="0 0 1.57"/>
        <axis xyz="1 0 0"/> <!-- Inverted axis -->
    </joint>

    <joint name="wheel_r_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_r_link"/>
        <origin xyz="0.052 -0.095 -0.0025" rpy="0 0 1.57"/>
        <axis xyz="1 0 0"/> <!-- Inverted axis -->
    </joint>

    <joint name="caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_link"/>
        <origin xyz="-0.075 0 -0.0425" rpy="0 0 0"/>
    </joint>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_frame"/>
        <origin xyz="0.05 0 0.11" rpy="0 0 0"/>
    </joint> 

    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>

        <joint name="wheel_l_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="wheel_r_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
            <ros>
        <remapping>odom:=/puzzlebot_odom</remapping>
      </ros>
    
            <!-- Wheel Information -->
            <left_joint>wheel_l_joint</left_joint>
            <right_joint>wheel_r_joint</right_joint>
            <wheel_separation>0.332</wheel_separation>
            <wheel_diameter>0.130</wheel_diameter>
            <OdomSource>0</OdomSource>
    
            <!-- Limits -->
            <max_wheel_torque>109</max_wheel_torque>
            <max_wheel_acceleration>5.0</max_wheel_acceleration>
    

            <!-- Output -->
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>

            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf>
    
    
        </plugin>
    </gazebo>
    <gazebo>
    <plugin name="gazebo_ros_joint_state_publisher"
        filename="libgazebo_ros_joint_state_publisher.so">
        <joint_name>wheel_l_joint</joint_name>
        <joint_name>wheel_r_joint</joint_name>
    </plugin>
  </gazebo>

    <gazebo reference="laser_frame">
        <sensor name="laser" type="ray">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>12</max>
                </range>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <argument>~/out:=scan</argument>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>laser_frame</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="base_footprint">
        <material>Gazebo/Black</material>
    </gazebo>

</robot>

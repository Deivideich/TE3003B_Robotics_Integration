<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="gazebo_tags" params="use_gazebo_controllers:=false use_gazebo_odom:=false">

    <!-- Conditionally include ros2_control configuration and diff_drive plugin -->
    <xacro:if value="${use_gazebo_controllers}">
      
      <!-- Gazebo Plugin: Differential Drive -->
      <gazebo>
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
          <ros>
            <remapping>odom:=/odom</remapping>
          </ros>

          <!-- Wheel Info -->
          <left_joint>wheel_l_joint</left_joint>
          <right_joint>wheel_r_joint</right_joint>
          <wheel_separation>0.19</wheel_separation>
          <wheel_diameter>0.10</wheel_diameter>
          <OdomSource>0</OdomSource>

          <!-- Limits -->
          <max_wheel_torque>109</max_wheel_torque>
          <max_wheel_acceleration>5.0</max_wheel_acceleration>

          <!-- Output config based on odom flag -->
          <odometry_frame>odom</odometry_frame>
          <robot_base_frame>base_footprint</robot_base_frame>
          <publish_odom><xacro:if value="${use_gazebo_odom}">true</xacro:if><xacro:unless value="${use_gazebo_odom}">false</xacro:unless></publish_odom>
          <publish_odom_tf><xacro:if value="${use_gazebo_odom}">true</xacro:if><xacro:unless value="${use_gazebo_odom}">false</xacro:unless></publish_odom_tf>
          <publish_wheel_tf>false</publish_wheel_tf>
        </plugin>
      </gazebo>

    </xacro:if>

    <!-- Laser sensor -->
    <gazebo reference="laser_frame">
      <sensor name="laser" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <min_angle>-3.14</min_angle>
              <max_angle>3.14</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.3</min>
            <max>5</max>
          </range>
        </ray>
        <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <argument>~/out:=scan</argument>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>laser_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Materials -->
    <gazebo reference="base_footprint">
      <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="wheel_l_link">
      <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="wheel_r_link">
      <material>Gazebo/Blue</material>
    </gazebo>

  </xacro:macro>
</robot>

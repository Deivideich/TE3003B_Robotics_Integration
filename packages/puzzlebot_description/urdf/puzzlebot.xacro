<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Properties and Macros -->
  <xacro:property name="mesh_dir" value="file://$(find puzzlebot_description)/meshes"/>

  <xacro:macro name="puzzlebot_description" params="prefix">
    <!-- Links -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0 0 0"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0 0 0"/></geometry>
      </collision>
    </link>

    <link name="${prefix}base_footprint">
      <visual>
        <origin xyz="0.052 0 0.10" rpy="1.57 0 3.1416"/>
        <geometry>
          <mesh filename="${mesh_dir}/MCR2_puzzlebot_jetson_lidar_base.stl" scale="1 1 1"/>
        </geometry>
        <material name="gray"><color rgba="0.6 0.6 0.6 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.052 0 0.10" rpy="1.57 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/MCR2_puzzlebot_jetson_lidar_base.stl" scale="1 1 1"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.052 0 0.10" rpy="1.57 0 0"/>
        <mass value="10.5"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <link name="${prefix}wheel_r_link">
      <visual>
        <origin xyz="0 0 0" rpy="3.14 1.57 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/MCR2_wheel.stl" scale="1 1 1"/>
        </geometry>
        <material name="blue"><color rgba="0 0 1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="3.14 1.57 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/MCR2_wheel.stl" scale="1 1 1"/>
        </geometry>
        <surface><friction><ode mu="0.0" mu2="0.0"/></friction></surface>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="3.14 1.57 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>

    <link name="${prefix}wheel_l_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 1.57 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/MCR2_wheel.stl" scale="1 1 1"/>
        </geometry>
        <material name="blue"><color rgba="0 0 1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 1.57 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/MCR2_wheel.stl" scale="1 1 1"/>
        </geometry>
        <surface><friction><ode mu="0.0" mu2="0.0"/></friction></surface>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 1.57 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>

    <link name="${prefix}caster_link">
      <visual>
        <geometry>
          <mesh filename="${mesh_dir}/MCR2_caster_wheel.stl" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_dir}/MCR2_caster_wheel.stl" scale="1 1 1"/>
        </geometry>
        <surface><friction><ode mu="0.0" mu2="0.0"/></friction></surface>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="3.5"/>
        <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
      </inertial>
    </link>

    <link name="${prefix}camera_base_link"/>

    <link name="${prefix}laser_frame"/>

    <link name="laser"/>

    <!-- Joints -->
    <joint name="${prefix}base_link_joint" type="fixed">
      <parent link="${prefix}base_footprint"/>
      <child link="${prefix}base_link"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}wheel_l_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}wheel_l_link"/>
      <origin xyz="0.052 0.095 -0.0025" rpy="0 0 1.57"/>
      <axis xyz="1 0 0"/>
    </joint>

    <joint name="${prefix}wheel_r_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}wheel_r_link"/>
      <origin xyz="0.052 -0.095 -0.0025" rpy="0 0 1.57"/>
      <axis xyz="1 0 0"/>
    </joint>

    <joint name="${prefix}caster_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}caster_link"/>
      <origin xyz="-0.075 0 -0.0425" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}camera_base_joint" type="fixed">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}camera_base_link"/>
        <origin xyz="0.112 0 0.065" rpy="0 0 0"/>
    </joint>


    <joint name="${prefix}laser_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}laser_frame"/>
      <origin xyz="0.05 0 0.11" rpy="0 0 0"/>
    </joint>

   <joint name="laser_frame_to_laser" type="fixed">
    <parent link="laser_frame"/>
    <child link="laser"/>
    <origin xyz="0 0 0" rpy="0 0 3.14"/>
   </joint>

  </xacro:macro>
</robot>

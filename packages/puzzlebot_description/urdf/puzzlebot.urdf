<?xml version="1.0"?>
<robot name="simple_robot"
    xmlns:xacro="http://ros.org/wiki/xacro">

    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_puzzlebot_jetson_lidar_base.stl" scale="1.0 1.0 1.0"/>
            </geometry>
            <material name="gray">
                <color rgba="0.6 0.6 0.6 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_puzzlebot_jetson_lidar_base.stl" scale="1.0 1.0 1.0"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <link name="wheel_r_link">
        <visual>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <link name="wheel_l_link">
        <visual>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <link name="caster_link">
        <visual>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_caster_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
            <material name="Blue"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find puzzlebot_description)/meshes/MCR2_caster_wheel.stl" scale="1.0 1.0 1.0"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <link name="laser_frame"/>

    <joint name="wheel_l_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_r_link"/>
        <origin xyz="0.0 -0.052 0.095" rpy="0 0 1.57"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.5" friction="0.5"/>
    </joint>

    <joint name="wheel_r_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_l_link"/>
        <origin xyz="0.0 -0.052 -0.095" rpy="0 0 -1.57"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.5" friction="0.5"/>
    </joint>

    <joint name="caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_link"/>
        <origin xyz="0.15 -0.095 0" rpy="-1.57 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.5" friction="0.5"/>
    </joint>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_frame"/>
        <origin xyz="0.122 0 0.212" rpy="0 0 0"/>
    </joint>

    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>

        <joint name="left_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
            <left_joint>wheel_l_joint</left_joint>
            <right_joint>wheel_r_joint</right_joint>
            <wheel_separation>0.3</wheel_separation>
            <wheel_radius>0.05</wheel_radius>
            <wheel_diameter>0.1</wheel_diameter>
            <publish_odom>true</publish_odom>
            <odom_topic>odom</odom_topic>
            <cmd_vel_topic>cmd_vel</cmd_vel_topic>
            <robot_base_frame>base_link</robot_base_frame>
        </plugin>
    </gazebo>

    <gazebo reference="laser_frame">
        <material>Gazebo/Black</material>

        <sensor name="laser" type="ray">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>12</max>
                </range>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <argument>~/out:=scan</argument>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>laser_frame</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>
